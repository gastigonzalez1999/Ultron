# Server Configuration
PORT=3001
CORS_ORIGIN=http://localhost:3000

# API Configuration
API_TIMEOUT=30000
API_RETRIES=3
LOG_LEVEL=info

# OpenAI Configuration (optional, for AI features)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4

# Environment Management
# The app will automatically switch between these environments
# Current environment can be changed via the UI

# Local Development Environment
PAYDOCK_LOCAL_BASE_URL=http://localhost:1337
PAYDOCK_LOCAL_API_KEY=your_local_paydock_secret_key_here

# Staging-11 Environment
PAYDOCK_STAGING_BASE_URL=https://apista-11.paydock.com
PAYDOCK_STAGING_API_KEY=your_staging_paydock_secret_key_here

# Legacy single environment config (fallback)
PAYDOCK_BASE_URL=http://localhost:1337
PAYDOCK_API_KEY=your_paydock_secret_key_here

# ===== ENVIRONMENT-SPECIFIC GATEWAY AND SERVICE CONFIGURATION =====
# Each environment has its own unique gateway IDs and service IDs
# This ensures proper isolation between local development and staging testing

# ===== LOCAL DEVELOPMENT ENVIRONMENT =====
# Gateway and Service IDs for local development

# Generic Gateway ID (used for basic flows)
GATEWAY_ID_LOCAL=your_local_gateway_id_here

# MPGS Gateway (for card verification and basic payments)
MPGS_SERVICE_LOCAL=your_local_mpgs_gateway_id_here

# MPGS Credentials (for composite flows)
MPGS_MERCHANT_ID_LOCAL=your_local_mpgs_merchant_id_here
MPGS_API_PASSWORD_LOCAL=your_local_mpgs_api_password_here
MPGS_API_USERNAME_LOCAL=your_local_mpgs_api_username_here

# GPayments 3DS Service (for 3DS authentication)
GPAYMENTS_SERVICE_LOCAL=your_local_gpayments_service_id_here

# Forter Fraud Detection Service
FORTER_SERVICE_ID_LOCAL=your_local_forter_service_id_here
FORTER_TOKEN_LOCAL=your_local_forter_token_here

# Wallet Payment Gateway
WALLET_GATEWAY_ID_LOCAL=your_local_wallet_gateway_id_here

# Fraud Charge ID (for fraud detection flows)
FRAUD_CHARGE_ID_LOCAL=your_local_fraud_charge_id_here

# Test Data Variables for Local Environment
VAULT_TOKEN_LOCAL=your_local_test_vault_token_here
VAULT_TOKEN_INBUILD_3DS_LOCAL=your_local_test_vault_token_3ds_here
OTT_TOKEN_LOCAL=your_local_test_ott_token_here
CUSTOMER_ID_LOCAL=your_local_test_customer_id_here
CHARGE_ID_LOCAL=your_local_test_charge_id_here
REFERENCE_LOCAL=your_local_test_reference_here
START_DATE_LOCAL=2024-01-01
END_DATE_LOCAL=2024-12-31
PAUSE_DATE_LOCAL=2024-06-01
CANCEL_DATE_LOCAL=2024-12-31

# ===== STAGING-11 ENVIRONMENT =====
# Gateway and Service IDs for staging testing

# Generic Gateway ID (used for basic flows)
GATEWAY_ID_STAGING=your_staging_gateway_id_here

# MPGS Gateway (for card verification and basic payments)
MPGS_SERVICE_STAGING=your_staging_mpgs_gateway_id_here

# MPGS Credentials (for composite flows)
MPGS_MERCHANT_ID_STAGING=your_staging_mpgs_merchant_id_here
MPGS_API_PASSWORD_STAGING=your_staging_mpgs_api_password_here
MPGS_API_USERNAME_STAGING=your_staging_mpgs_api_username_here

# GPayments 3DS Service (for 3DS authentication)
GPAYMENTS_SERVICE_STAGING=your_staging_gpayments_service_id_here

# Forter Fraud Detection Service
FORTER_SERVICE_ID_STAGING=your_staging_forter_service_id_here
FORTER_TOKEN_STAGING=your_staging_forter_token_here

# Wallet Payment Gateway
WALLET_GATEWAY_ID_STAGING=your_staging_wallet_gateway_id_here

# Fraud Charge ID (for fraud detection flows)
FRAUD_CHARGE_ID_STAGING=your_staging_fraud_charge_id_here

# Test Data Variables for Staging Environment
VAULT_TOKEN_STAGING=your_staging_test_vault_token_here
VAULT_TOKEN_INBUILD_3DS_STAGING=your_staging_test_vault_token_3ds_here
OTT_TOKEN_STAGING=your_staging_test_ott_token_here
CUSTOMER_ID_STAGING=your_staging_test_customer_id_here
CHARGE_ID_STAGING=your_staging_test_charge_id_here
REFERENCE_STAGING=your_staging_test_reference_here
START_DATE_STAGING=2024-01-01
END_DATE_STAGING=2024-12-31
PAUSE_DATE_STAGING=2024-06-01
CANCEL_DATE_STAGING=2024-12-31

# ===== WEBHOOK CONFIGURATION =====
# Webhook settings for testing DPA registration notifications
# For local development, you can use ngrok or webhook.site
# Example: WEBHOOK_URL_LOCAL=https://your-ngrok-url.ngrok.io/api/v1/webhooks/network-tokens/SCOF/handle/notifications/dpa
# Example: WEBHOOK_URL_LOCAL=https://webhook.site/your-unique-id/api/v1/webhooks/network-tokens/SCOF/handle/notifications/dpa
WEBHOOK_URL_LOCAL=https://your-local-webhook-endpoint.com/api/v1/webhooks/network-tokens/SCOF/handle/notifications/dpa

# Staging-11 webhook configuration
WEBHOOK_URL_STAGING_11=https://your-staging-11-webhook-endpoint.com/api/v1/webhooks/network-tokens/SCOF/handle/notifications/dpa

# ===== ENVIRONMENT-SPECIFIC GATEWAY PRESETS =====
# Uncomment and configure these for different environments

# Local Development Preset
# GATEWAY_ID=67e6a08f6c475cedc947b5de
# MPGS_SERVICE=5cbede1f151b842653e987be
# GPAYMENTS_SERVICE=your_local_gpayments_id
# FORTER_SERVICE_ID=62aa30065176bb57ed4505e8
