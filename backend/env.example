# Staging-11 Environment Preset
# GATEWAY_ID=staging_gateway_id
# MPGS_SERVICE=staging_mpgs_id
# GPAYMENTS_SERVICE=staging_gpayments_id
# FORTER_SERVICE_ID=staging_forter_id
# WALLET_PAYPAL_GATEWAY_ID=staging_wallet_id
# ADVAM_GATEWAY_ID=
#AFTERPAY_GATEWAY_ID=
#ADYEN_GATEWAY_ID=
#CYBERSOURCE_GATEWAY_ID=
#PAYPAL_GATEWAY_ID=
#ACCERTIFY_SERVICE_ID=
CTP_REGISTRATION_ID=
NT_REGISTRATION_ID_SCOF=
NT_REGISTRATION_ID_VTS=
NT_SERVICE_ID_SCOF=
NT_SERCICE_ID_VTS=
CTP_SERVICE_ID=

# Development Settings
NODE_ENV=development
